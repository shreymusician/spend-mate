{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev:memory"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173,
      "env": {
        "SPENDMATE_API": "http://localhost:4001"
      }
    }
  ]
}