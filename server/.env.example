NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/spendmate for local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendmate
# At least 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# Same idea, different value. Changing it later signs everyone out of PIN login (they would need a PIN reset).
PIN_PEPPER=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_ORIGIN=http://localhost:5173
